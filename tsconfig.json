{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tools/**/*.ts", "tests/**/*.ts", "*.ts"]
}
