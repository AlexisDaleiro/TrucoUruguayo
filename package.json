{
  "name": "truco-de-boliche",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:client": "pnpm --filter @truco/client dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "pnpm --filter @truco/client build && node tools/pwa-build.mjs && node tools/budget.mjs && node tools/art/verify.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sim": "tsx packages/bots/src/sim.ts",
    "deploy": "pnpm build && wrangler deploy",
    "android:sync": "pnpm build && cap sync android",
    "art:build": "tsx tools/art/cards.tsx && node tools/art/build.mjs",
    "voices:plan": "tsx tools/voices/generate.ts",
    "voices:generate": "tsx tools/voices/generate.ts --execute"
  },
  "devDependencies": {
    "@assetpack/core": "1.7.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "sharp": "0.34.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
